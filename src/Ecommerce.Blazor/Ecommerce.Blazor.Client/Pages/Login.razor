@page "/login"
@using Ecommerce.Blazor.Client.Components
@using Ecommerce.Blazor.Client.Features.Auth;
@inject AuthState AuthState;
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div class="w-full flex justify-center sm:py-10">
    <div class="w-full sm:max-w-md bg-white sm:shadow-lg sm:border sm:border-gray-100 sm:rounded-2xl p-6 flex-1 flex flex-col gap-4">
        <div class="flex flex-col gap-2">
            <span class="font-bold text-blue-600">WELCOME BACK</span>
            <span class="font-bold text-xl">Log in to your account</span>
            <span>Enter your details below to access your account and continue shopping.</span>
        </div>
    
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div>
                <ErrorBox Error="@errorMessage" />
            </div>
        }
        
        <div class="flex flex-col gap-4">
            <CustomInput Label="Email address" Placeholder="you@example.com" Type="email" Icon="mail" @bind-Value="email" />
            <CustomInput Label="Password" Placeholder="Enter your password" Type="password" Icon="lock" @bind-Value="password" />
        </div>
    
        <div class="flex flex-row justify-between">
            <div><input type="checkbox" checked="checked"/> Remember me</div>
            <a href="/forgot-password" class="text-blue-600">Forgot password?</a>
        </div>
    
        <div>
            <button class="w-full bg-blue-500 text-white font-bold py-1.5 rounded-lg" @onclick="HandleLogin">Log in</button>
        </div>
    
        <div class="w-full h-px bg-gray-300"></div>
    
        <div class="self-center">
            <span>Don't have an account?</span>
            <a class="text-blue-600 underline" href="/register">Register</a>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? errorMessage;

    private async Task HandleLogin()
    {
        errorMessage = null;

        if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(password))
        {
            errorMessage = "Please fill all field.";
            return;
        }

        try
        {
            await AuthState.LoginAsync(email, password);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}