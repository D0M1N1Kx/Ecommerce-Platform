@page "/"
@using Ecommerce.Blazor.Client.Components
@using Ecommerce.Blazor.Client.Features.Category
@inject CategoryState CategoryState

<PageTitle>Home</PageTitle>
@if (CategoryState.Categories.Count > 0)
{
    <div class="grid grid-cols-3 md:grid-cols-6 gap-3 sm:gap-4 w-full">
        @foreach (var category in CategoryState.Categories.Take(6))
        {
            <CategoryBox Name="@category.Name" ImgUrl="@category.ImgUrl"/>
        }
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await CategoryState.LoadCategoriesAsync();
    }
}