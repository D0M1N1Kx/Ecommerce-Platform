<div class="flex flex-col items-center justify-center sm:bg-gray-50 sm:hover:bg-gray-100 bg-gray-200 hover:bg-gray-300 rounded-2xl p-3 sm:p-5 transition-all cursor-pointer group">
    <div class="w-12 h-12 sm:w-16 sm:h-16 flex items-center justify-ceter mb-2 sm:mb-3 group-hover:scale-105 transition-transform">
        <img src="@ImgUrl" alt="@Name" class="max-w-full max-h-full object-contain"/>
    </div>
    
    <span class="text-xs sm:text-sm font-semibold text-gray-800 text-center leading-tight">
        @Name
    </span>
</div>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string ImgUrl { get; set; } = string.Empty;
}